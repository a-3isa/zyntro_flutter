rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isModerator() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }
    
    // Check if request is trying to modify moderation-sensitive fields
    function isModerationFieldChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isModerator', 'isBanned', 'bannedUntil', 'banReason']);
    }

    // Users collection
    // Users can update their own profile data including streak cache and notification preferences
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Owners can update their profile, but only moderators can change moderation fields
      allow update: if (isOwner(userId) && !isModerationFieldChange()) || isModerator();
      allow delete: if false;
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;

      match /timeline/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if false;
        allow delete: if false;
      }
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && reactionId == request.auth.uid;
        allow delete: if isAuthenticated() && reactionId == request.auth.uid;
      }
    }

    // Follows collection
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followeeId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followeeId == request.auth.uid
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Allow read for authenticated users - app queries filter by userId
      // Note: resource.data check fails for list queries, so we allow read broadly
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Reports collection - for user/post/comment reports
    match /reports/{reportId} {
      // Users can read their own submitted reports; moderators can read all
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        isModerator()
      );
      // Only authenticated users can create reports, and only for themselves
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      // Only moderators can update report status
      allow update: if isModerator();
      // Reports should never be deleted
      allow delete: if false;
    }

    // Blocks collection - for blocking users
    match /blocks/{blockId} {
      // Allow read for authenticated users - app queries filter by blockerId
      // Note: resource.data check fails for list queries, so we allow read broadly
      allow read: if isAuthenticated();
      // Users can only create blocks for themselves
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      // Blocks cannot be updated, only deleted
      allow update: if false;
      // Users can only delete their own blocks (document lookup works for single doc)
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    // BuddyPairs collection
    match /buddyPairs/{pairId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Push tokens collection
    match /pushTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
