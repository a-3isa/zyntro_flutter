rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasParticipant(participants, userId) {
      return participants != null && participants.hasAny([userId]);
    }

    function isPendingSessionInvitee(sessionData, userId) {
      return sessionData.invitationStatus == 'pending' &&
        sessionData.invitedUserIds != null &&
        sessionData.invitedUserIds.size() == 1 &&
        sessionData.invitedUserIds[0] == userId;
    }

    function isPendingSessionInviteeById(sessionId) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return exists(path) &&
        isPendingSessionInvitee(get(path).data, request.auth.uid);
    }

    function isInviteDeclineUpdate() {
      return isPendingSessionInvitee(resource.data, request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['invitationStatus', 'declinedBy']) &&
        request.resource.data.invitationStatus == 'declined' &&
        request.resource.data.declinedBy == request.auth.uid;
    }

    function isPlanOwner(planUserId) {
      return planUserId == request.auth.uid;
    }

    function isMutualApprovedFollow(hostId, inviteeId) {
      return exists(/databases/$(database)/documents/follows/$(hostId + '_' + inviteeId)) &&
        exists(/databases/$(database)/documents/follows/$(inviteeId + '_' + hostId)) &&
        get(/databases/$(database)/documents/follows/$(hostId + '_' + inviteeId)).data.status == 'approved' &&
        get(/databases/$(database)/documents/follows/$(inviteeId + '_' + hostId)).data.status == 'approved';
    }

    function isNotBlockedPair(hostId, inviteeId) {
      return !exists(/databases/$(database)/documents/blocks/$(hostId + '_' + inviteeId)) &&
        !exists(/databases/$(database)/documents/blocks/$(inviteeId + '_' + hostId));
    }

    function hasValidPairedInviteEligibility() {
      return !request.resource.data.keys().hasAny(['invitedUserIds']) ||
        request.resource.data.invitedUserIds.size() == 0 ||
        (
          request.resource.data.invitedUserIds.size() == 1 &&
          isMutualApprovedFollow(request.resource.data.hostId, request.resource.data.invitedUserIds[0]) &&
          isNotBlockedPair(request.resource.data.hostId, request.resource.data.invitedUserIds[0])
        );
    }

    function isModerator() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }

    function isModerationFieldChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isModerator', 'isBanned', 'bannedUntil', 'banReason']);
    }

    function privilegedUserFields() {
      return [
        'isModerator',
        'isBanned',
        'bannedUntil',
        'banReason',
        'hasGlobalLeaderboardAccess',
        'globalLeaderboardAccessGrantedAt',
        'globalLeaderboardPaymentId',
        'transactions'
      ];
    }

    function isPrivilegedUserCreate() {
      return request.resource.data.keys().hasAny(privilegedUserFields());
    }

    function isPrivilegedUserFieldChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(privilegedUserFields());
    }

    function isFollowStatusChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status']);
    }

    function isSessionMember(sessionId) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return existsAfter(path) && hasParticipant(getAfter(path).data.participants, request.auth.uid);
    }

    function isBotSessionHost(sessionId) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return existsAfter(path) &&
        getAfter(path).data.partnerKind == 'bot' &&
        getAfter(path).data.hostId == request.auth.uid &&
        hasParticipant(getAfter(path).data.participants, request.auth.uid);
    }

    function isApprovedEventJoinUpdate(eventId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantCount']) &&
        request.resource.data.participantCount == resource.data.participantCount + 1 &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)/joinedEvents/$(eventId)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/joinedEvents/$(eventId)) != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && !isPrivilegedUserCreate();
      allow update: if (isOwner(userId) && !isPrivilegedUserFieldChange()) || isModerator();
      allow delete: if false;

      match /settings/{settingId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        // Any authenticated user may create a notification for another user
        // (session invites, follow events). The userId field must match the
        // collection's userId so a sender cannot forge the recipient.
        allow create: if isAuthenticated() && request.resource.data.userId == userId;
      }

      match /stats/{statId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isOwner(userId);
      }

      match /joinedEvents/{eventId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Username registry — enforces unique handles. Doc id is the lowercase
    // username. A handle is claimed once and never reassigned.
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow update, delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        (hasParticipant(resource.data.participants, request.auth.uid) ||
        isPendingSessionInvitee(resource.data, request.auth.uid));
      allow create: if isAuthenticated() &&
        request.resource.data.hostId == request.auth.uid &&
        hasParticipant(request.resource.data.participants, request.auth.uid) &&
        hasValidPairedInviteEligibility();
      allow update: if isAuthenticated() && (
        hasParticipant(resource.data.participants, request.auth.uid) ||
        hasParticipant(request.resource.data.participants, request.auth.uid) ||
        isInviteDeclineUpdate()
      );
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isSessionMember(sessionId);
        allow create: if isAuthenticated() &&
          isSessionMember(sessionId) &&
          (
            request.resource.data.userId == request.auth.uid ||
            (
              isBotSessionHost(sessionId) &&
              request.resource.data.userId == 'zyntro_bot_friend'
            )
          );
        allow update, delete: if false;
      }

      match /plans/{planUserId} {
        allow read: if isSessionMember(sessionId) ||
          isPendingSessionInviteeById(sessionId);
        allow create: if (
          isOwner(planUserId) &&
          isPlanOwner(planUserId) &&
          isSessionMember(sessionId) &&
          request.resource.data.userId == planUserId
        ) || (
          isBotSessionHost(sessionId) &&
          planUserId == 'zyntro_bot_friend' &&
          request.resource.data.userId == planUserId
        );
        allow update: if (
          isOwner(planUserId) &&
          isPlanOwner(planUserId) &&
          isSessionMember(sessionId) &&
          request.resource.data.userId == planUserId
        ) || (
          isBotSessionHost(sessionId) &&
          planUserId == 'zyntro_bot_friend' &&
          request.resource.data.userId == planUserId
        );
        allow delete: if false;
      }

      match /presence/{presenceUserId} {
        allow read: if isSessionMember(sessionId);
        allow create, update, delete: if isOwner(presenceUserId) && isSessionMember(sessionId);
      }
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && reactionId == request.auth.uid;
        allow delete: if isAuthenticated() && reactionId == request.auth.uid;
      }
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.followerId == request.auth.uid && !isFollowStatusChange()) ||
        resource.data.followeeId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followeeId == request.auth.uid
      );
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        isModerator()
      );
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isModerator();
      allow delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.blockerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    match /buddyPairs/{pairId} {
      allow read: if isAuthenticated() &&
        hasParticipant(resource.data.participants, request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.initiatorId == request.auth.uid &&
        request.resource.data.participants.size() == 1 &&
        request.resource.data.participants[0] == request.auth.uid;
      allow update: if isAuthenticated() &&
        hasParticipant(request.resource.data.participants, request.auth.uid);
      allow delete: if false;
    }

    match /inviteCodes/{inviteCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.usedBy == request.auth.uid
      );
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isAuthenticated() && isApprovedEventJoinUpdate(eventId);
      allow delete: if false;
    }

    match /workouts/{workoutId} {
      allow read: if isAuthenticated();
      // Verify membership via the workout's own participants field.
      // Using isSessionMember (which calls getAfter) is unreliable when the
      // session document is also updated in the same batched write.
      allow create: if isAuthenticated() &&
        request.resource.data.sessionId is string &&
        request.resource.data.participants != null &&
        request.resource.data.participants.hasAny([request.auth.uid]);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /pushQueue/{messageId} {
      allow read, create, update, delete: if false;
    }

    match /pushTokens/{tokenId} {
      allow read, create, update, delete: if false;
    }

    // Exercise catalog — shared read, moderator-only write (T013)
    match /exerciseCatalog/{exerciseId} {
      allow read: if isAuthenticated() && resource.data.isActive == true;
      allow create, update, delete: if isModerator();
    }

    // Personal exercises — owner-only access (T013)
    match /users/{userId}/personalExercises/{personalExerciseId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Exercise review submissions — user creates for own exercises,
    // only moderators may change status (approve/reject/merge) (T013)
    match /exerciseReviewSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid ||
        isModerator()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if isModerator();
      allow delete: if false;
    }
  }
}
