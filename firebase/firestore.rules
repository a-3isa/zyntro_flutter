rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasParticipant(participants, userId) {
      return participants != null && participants.hasAny([userId]);
    }

    function isPendingSessionInvitee(sessionData, userId) {
      return sessionData.invitationStatus == 'pending' &&
        sessionData.invitedUserIds != null &&
        sessionData.invitedUserIds.size() == 1 &&
        sessionData.invitedUserIds[0] == userId;
    }

    function isPendingSessionInviteeById(sessionId) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return exists(path) &&
        isPendingSessionInvitee(get(path).data, request.auth.uid);
    }

    // A pending invitee adding themselves to the session — the only legitimate
    // self-add. Guards every part of the join transition so a client cannot use
    // it to bypass invite/eligibility/expiry checks, replace the participant
    // roster, add extra users, or rewrite another participant's workout type.
    function isInviteAcceptUpdate() {
      return isPendingSessionInvitee(resource.data, request.auth.uid) &&
        resource.data.status == 'active' &&
        resource.data.phase == 'setup' &&
        !hasParticipant(resource.data.participants, request.auth.uid) &&
        // participants grows by exactly one and keeps every prior member, so the
        // single added entry must be the caller — no replacement, no extras.
        request.resource.data.participants.size() ==
          resource.data.participants.size() + 1 &&
        request.resource.data.participants.hasAll(resource.data.participants) &&
        hasParticipant(request.resource.data.participants, request.auth.uid) &&
        // only the caller's own workout type may be added to the map.
        request.resource.data.participantTypes.diff(resource.data.participantTypes)
          .affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.invitationStatus == 'accepted' &&
        resource.data.inviteExpiresAt is timestamp &&
        resource.data.inviteExpiresAt > request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participants', 'participantTypes', 'invitationStatus', 'mode']);
    }

    // An existing participant updating live session state (turn, phase, status,
    // clock, roster for matchmaking, etc.). The immutable identity fields are
    // frozen so a participant cannot hijack the host, tamper with the invite
    // list, or forge the invite status. (participants stays mutable because the
    // matchmaking host legitimately adds the matched partner to the roster.)
    function isParticipantSessionUpdate() {
      return hasParticipant(resource.data.participants, request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['hostId', 'invitedUserIds', 'invitationStatus']) &&
        request.resource.data.participantTypes.diff(resource.data.participantTypes).affectedKeys().hasOnly([request.auth.uid]);
    }

    // A user joining an open (non-paired) session — random matchmaking or a gym
    // setup room. They may add only themselves and keep every existing member;
    // paired-invite sessions (which carry an invitationStatus) are excluded and
    // must use the strict isInviteAcceptUpdate transition instead.
    function isGenericSelfJoinUpdate() {
      return !resource.data.keys().hasAny(['invitationStatus']) &&
        !hasParticipant(resource.data.participants, request.auth.uid) &&
        request.resource.data.participants.size() ==
          resource.data.participants.size() + 1 &&
        request.resource.data.participants.hasAll(resource.data.participants) &&
        hasParticipant(request.resource.data.participants, request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participants']);
    }

    function isInviteDeclineUpdate() {
      return isPendingSessionInvitee(resource.data, request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['invitationStatus', 'declinedBy']) &&
        request.resource.data.invitationStatus == 'declined' &&
        request.resource.data.declinedBy == request.auth.uid;
    }

    function isBuddyInviteCodeRedeemUpdate() {
      return isAuthenticated() &&
        resource.data.creatorId != request.auth.uid &&
        !resource.data.keys().hasAny(['usedAt', 'usedBy']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['usedAt', 'usedBy']) &&
        request.resource.data.usedBy == request.auth.uid &&
        request.resource.data.usedAt is timestamp &&
        resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;
    }

    function isBuddyPairInviteAcceptUpdate() {
      return isAuthenticated() &&
        resource.data.status == 'pending' &&
        resource.data.initiatorId != request.auth.uid &&
        !hasParticipant(resource.data.participants, request.auth.uid) &&
        request.resource.data.participants.size() ==
          resource.data.participants.size() + 1 &&
        request.resource.data.participants.hasAll(resource.data.participants) &&
        hasParticipant(request.resource.data.participants, request.auth.uid) &&
        request.resource.data.status == 'active' &&
        request.resource.data.activatedAt is timestamp &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participants', 'status', 'activatedAt']) &&
        existsAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.inviteCode)) &&
        getAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.inviteCode)).data.usedBy == request.auth.uid;
    }

    function isPlanOwner(planUserId) {
      return planUserId == request.auth.uid;
    }

    function isMutualApprovedFollow(hostId, inviteeId) {
      return exists(/databases/$(database)/documents/follows/$(hostId + '_' + inviteeId)) &&
        exists(/databases/$(database)/documents/follows/$(inviteeId + '_' + hostId)) &&
        get(/databases/$(database)/documents/follows/$(hostId + '_' + inviteeId)).data.status == 'approved' &&
        get(/databases/$(database)/documents/follows/$(inviteeId + '_' + hostId)).data.status == 'approved';
    }

    function isNotBlockedPair(hostId, inviteeId) {
      return !exists(/databases/$(database)/documents/blocks/$(hostId + '_' + inviteeId)) &&
        !exists(/databases/$(database)/documents/blocks/$(inviteeId + '_' + hostId));
    }

    function hasValidPairedInviteEligibility() {
      return !request.resource.data.keys().hasAny(['invitedUserIds']) ||
        request.resource.data.invitedUserIds.size() == 0 ||
        (
          request.resource.data.invitedUserIds.size() == 1 &&
          isMutualApprovedFollow(request.resource.data.hostId, request.resource.data.invitedUserIds[0]) &&
          isNotBlockedPair(request.resource.data.hostId, request.resource.data.invitedUserIds[0])
        );
    }

    function isModerator() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }

    function privilegedUserFields() {
      return [
        'isModerator',
        'isBanned',
        'bannedUntil',
        'banReason',
        'hasGlobalLeaderboardAccess',
        'globalAccessGrantedAt',
        'globalLeaderboardAccessGrantedAt',
        'globalLeaderboardPaymentId',
        'transactions'
      ];
    }

    function isPrivilegedUserCreate() {
      return request.resource.data.keys().hasAny(privilegedUserFields());
    }

    function isPrivilegedUserFieldChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(privilegedUserFields());
    }

    function isFollowStatusChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status']);
    }

    function isSessionMember(sessionId) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return existsAfter(path) && hasParticipant(getAfter(path).data.participants, request.auth.uid);
    }

    // True when sessions/{sessionId} exists AND its participants array contains
    // every uid in userIds. Unlike isSessionMember this reads the session's
    // CURRENT state (exists/get, not existsAfter/getAfter) because the caller is
    // writing a different collection entirely — the session is not part of the
    // same write.
    function sessionHasAllParticipants(sessionId, userIds) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return exists(path) &&
        get(path).data.participants != null &&
        get(path).data.participants.hasAll(userIds);
    }

    function isBotSessionHost(sessionId) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return existsAfter(path) &&
        getAfter(path).data.partnerKind == 'bot' &&
        getAfter(path).data.hostId == request.auth.uid &&
        hasParticipant(getAfter(path).data.participants, request.auth.uid);
    }

    function isApprovedEventJoinUpdate(eventId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantCount']) &&
        request.resource.data.participantCount == resource.data.participantCount + 1 &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)/joinedEvents/$(eventId)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/joinedEvents/$(eventId)) != null;
    }

    function isAnalyticsEventCreate() {
      return isAuthenticated() &&
        request.resource.data.diff({}).affectedKeys().hasOnly(['type', 'timestamp', 'userId', 'sessionId', 'hostId', 'partnerId', 'partnerKind', 'mode', 'workoutType', 'postId', 'originalSizeBytes', 'uploadDurationMs', 'finalSizeBytes', 'wasCompressed', 'compressionReductionPercent', 'errorType', 'errorMessage', 'attemptNumber', 'compressedSizeBytes', 'sizeReductionPercent', 'originalDimensions', 'planUserId', 'source', 'isReady', 'waitingOnPlan']) &&
        request.resource.data.keys().hasAll(['type', 'timestamp']) &&
        request.resource.data.type is string &&
        request.resource.data.timestamp == request.time &&
        (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid) &&
        (!request.resource.data.keys().hasAny(['hostId', 'partnerId']) || request.auth.uid in [request.resource.data.hostId, request.resource.data.partnerId]);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && !isPrivilegedUserCreate();
      allow update: if (isOwner(userId) && !isPrivilegedUserFieldChange()) || isModerator();
      allow delete: if false;

      match /settings/{settingId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        // Clients may only create their OWN notifications. All cross-user
        // notifications (session invites, follow/like/comment events) are
        // written by the trusted Cloud Function via the Admin SDK, which
        // bypasses these rules. This prevents forged/spam notifications.
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
      }

      match /stats/{statId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isOwner(userId);
      }

      match /joinedEvents/{eventId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Username registry — enforces unique handles. Doc id is the lowercase
    // username. A handle is claimed once and never reassigned.
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow update, delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        (hasParticipant(resource.data.participants, request.auth.uid) ||
        isPendingSessionInvitee(resource.data, request.auth.uid));
      allow create: if isAuthenticated() &&
        request.resource.data.hostId == request.auth.uid &&
        hasParticipant(request.resource.data.participants, request.auth.uid) &&
        hasValidPairedInviteEligibility();
      allow update: if isAuthenticated() && (
        isParticipantSessionUpdate() ||
        isInviteAcceptUpdate() ||
        isInviteDeclineUpdate() ||
        isGenericSelfJoinUpdate()
      );
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isSessionMember(sessionId);
        allow create: if isAuthenticated() &&
          isSessionMember(sessionId) &&
          (
            request.resource.data.userId == request.auth.uid ||
            (
              isBotSessionHost(sessionId) &&
              request.resource.data.userId == 'zyntro_bot_friend'
            )
          );
        allow update, delete: if false;
      }

      match /plans/{planUserId} {
        allow read: if isSessionMember(sessionId) ||
          isPendingSessionInviteeById(sessionId);
        allow create: if (
          isOwner(planUserId) &&
          isPlanOwner(planUserId) &&
          isSessionMember(sessionId) &&
          request.resource.data.userId == planUserId
        ) || (
          isBotSessionHost(sessionId) &&
          planUserId == 'zyntro_bot_friend' &&
          request.resource.data.userId == planUserId
        );
        allow update: if (
          isOwner(planUserId) &&
          isPlanOwner(planUserId) &&
          isSessionMember(sessionId) &&
          request.resource.data.userId == planUserId
        ) || (
          isBotSessionHost(sessionId) &&
          planUserId == 'zyntro_bot_friend' &&
          request.resource.data.userId == planUserId
        );
        allow delete: if false;
      }

      match /presence/{presenceUserId} {
        allow read: if isSessionMember(sessionId);
        allow create, update, delete: if isOwner(presenceUserId) && isSessionMember(sessionId);
      }
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();

      function isSoloCreate() {
        return request.resource.data.authorId == request.auth.uid &&
          request.resource.data.coAuthored != true &&
          (!request.resource.data.keys().hasAny(['authorIds']) ||
             request.resource.data.authorIds == [request.auth.uid]) &&
          (!request.resource.data.keys().hasAny(['authors']) ||
             request.resource.data.authors.size() == 0);
      }
      // A joint draft may only be created by someone who actually shared the
      // named session with the other author.
      //
      // ATTACK THIS PREVENTS (without the sessionHasAllParticipants check a
      // malicious client could create a coAuthored draft naming ANY other user
      // as co-author — no shared session required — and that draft would then
      // surface to the victim as a "post it together?" invite, and could reach
      // the victim's own profile grid once published): the session must exist
      // and its participants array must contain BOTH authorIds.
      function isJointDraftCreate() {
        return request.resource.data.coAuthored == true &&
          request.resource.data.status == 'draft' &&
          request.resource.data.authorIds.size() == 2 &&
          request.resource.data.authorIds.hasAny([request.auth.uid]) &&
          request.resource.data.authors.keys().hasAll(request.resource.data.authorIds) &&
          request.resource.data.authorIds.hasAll(request.resource.data.authors.keys()) &&
          request.resource.data.sessionId is string &&
          sessionHasAllParticipants(
            request.resource.data.sessionId,
            request.resource.data.authorIds
          );
      }
      allow create: if isAuthenticated() && (isSoloCreate() || isJointDraftCreate());

      // The ONLY top-level field a client may change on a co-authored post is
      // the `authors` map, and inside it only their own slot.
      //
      // ATTACK THIS PREVENTS: an earlier version enumerated frozen fields
      // (authorIds/coAuthored/sessionId/authorId/status) instead of constraining
      // the whole top-level diff. That made the inner
      // `authors.diff(...).hasOnly([uid])` check vacuously true whenever the
      // write's real diff landed on some OTHER top-level field — so a co-author
      // could raw-write `visibility: 'public'` alone on a published joint post
      // (defeating the "if either author picks private the post is private"
      // rule) or rewrite title/summary/mediaURLs/likesCount at will.
      // hasOnly(['authors']) freezes every one of those by construction, and
      // still blocks a client-side publish because `status` is not in the list.
      function isOwnAuthorSlotUpdate() {
        return resource.data.coAuthored == true &&
          request.resource.data.authorIds.hasAny([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authors']) &&
          request.resource.data.authors.diff(resource.data.authors).affectedKeys().hasOnly([request.auth.uid]);
      }

      // Engagement counters on a joint post, at exact parity with the solo
      // branch below (which lets only the post's own author touch non-identity
      // fields, counters included). Callers who are not an author of the post
      // are denied here exactly as a non-owner is denied on a solo post.
      function isJointAuthorCounterUpdate() {
        return resource.data.coAuthored == true &&
          resource.data.authorIds.hasAny([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'commentsCount']);
      }
      allow update: if isAuthenticated() && (
        (resource.data.authorId == request.auth.uid &&
         resource.data.coAuthored != true &&
         request.resource.data.coAuthored != true &&
         !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['authorIds', 'authors', 'authorId', 'coAuthored'])) ||
        isOwnAuthorSlotUpdate() ||
        isJointAuthorCounterUpdate()
      );

      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid
        && resource.data.coAuthored != true;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.keys()
            .hasOnly(['authorId', 'authorName', 'authorPhotoURL', 'text', 'type', 'createdAt', 'audioUrl']);
        allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          reactionId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['type', 'createdAt']);
        allow update: if isAuthenticated() && reactionId == request.auth.uid;
        allow delete: if isAuthenticated() && reactionId == request.auth.uid;
      }
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.followerId == request.auth.uid && !isFollowStatusChange()) ||
        resource.data.followeeId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followeeId == request.auth.uid
      );
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        isModerator()
      );
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isModerator();
      allow delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.blockerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    match /buddyPairs/{pairId} {
      allow read: if isAuthenticated() &&
        hasParticipant(resource.data.participants, request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.initiatorId == request.auth.uid &&
        request.resource.data.participants.size() == 1 &&
        request.resource.data.participants[0] == request.auth.uid;
      allow update: if isAuthenticated() && (
        hasParticipant(resource.data.participants, request.auth.uid) ||
        isBuddyPairInviteAcceptUpdate()
      );
      allow delete: if false;
    }

    match /inviteCodes/{inviteCode} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['code', 'creatorId', 'buddyPairId', 'expiresAt']) &&
        request.resource.data.code == inviteCode &&
        request.resource.data.expiresAt is timestamp;
      allow update: if isBuddyInviteCodeRedeemUpdate();
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isAuthenticated() && isApprovedEventJoinUpdate(eventId);
      allow delete: if false;
    }

    match /workouts/{workoutId} {
      allow read: if isAuthenticated();
      // Verify membership via the workout's own participants field.
      // Using isSessionMember (which calls getAfter) is unreliable when the
      // session document is also updated in the same batched write.
      allow create: if isAuthenticated() &&
        request.resource.data.sessionId is string &&
        request.resource.data.participants != null &&
        request.resource.data.participants.hasAny([request.auth.uid]);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /analytics/{eventId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAnalyticsEventCreate();
      allow update, delete: if false;
    }

    match /pushQueue/{messageId} {
      allow read, create, update, delete: if false;
    }

    match /pushTokens/{tokenId} {
      allow read, create, update, delete: if false;
    }

    // Exercise catalog — shared read, moderator-only write (T013)
    match /exerciseCatalog/{exerciseId} {
      allow read: if isAuthenticated() && resource.data.isActive == true;
      allow create, update, delete: if isModerator();
    }

    // Personal exercises — owner-only access (T013)
    match /users/{userId}/personalExercises/{personalExerciseId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Exercise review submissions — user creates for own exercises,
    // only moderators may change status (approve/reject/merge) (T013)
    match /exerciseReviewSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid ||
        isModerator()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid;
      allow update: if isModerator();
      allow delete: if false;
    }
  }
}
