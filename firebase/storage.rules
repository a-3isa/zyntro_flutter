rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUnder5Mb() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function isImageContent() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png)');
    }

    function isAudioContent() {
      return request.resource.contentType.matches('audio/(mp4|mpeg|aac|wav|x-m4a)');
    }

    function isSessionParticipant(sessionId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/sessions/$(sessionId)) &&
        request.auth.uid in
          firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.participants;
    }

    function isPostOwner(postId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/posts/$(postId)) &&
        firestore.get(/databases/(default)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    match /posts/{postId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isPostOwner(postId) && isImageContent() && isUnder5Mb();
    }

    match /profilePhotos/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImageContent() && isUnder5Mb();
    }

    match /voiceNotes/{sessionId}/{fileName} {
      allow read: if isSessionParticipant(sessionId);
      allow write: if isSessionParticipant(sessionId) && isAudioContent() && isUnder5Mb();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
